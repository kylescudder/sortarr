# Local development. In production these come from the udms stack on Forge.
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
HOST=127.0.0.1
PORT=3210

# Postgres (runtime role). Migrations: bun run db:migrate with an owner URL.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/sortarr

# Better Auth. BETTER_AUTH_URL must equal APP_ORIGIN (https in production).
APP_ORIGIN=http://127.0.0.1:3210
BETTER_AUTH_URL=http://127.0.0.1:3210
BETTER_AUTH_SECRET=
BREVO_API_KEY=
AUTH_EMAIL_FROM=sortarr@kylescudder.co.uk
AUTH_EMAIL_DAILY_LIMIT=40
AUTH_ALLOWED_EMAILS=
